        </mxCell>

        <!-- Response path note -->
        <mxCell id="resp3" value="Response flows back:&#xa;Target Lambda → Gateway → Agent → AgentCore Runtime → User" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="460" height="50" as="geometry"/>

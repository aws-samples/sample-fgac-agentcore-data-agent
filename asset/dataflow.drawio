          <mxGeometry x="380" y="410" width="280" height="80" as="geometry"/>
        </mxCell>

        <!-- Athena → LF -->
        <mxCell id="e3_3" value="LF checks IAM role's tag permissions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="athena3" target="lf3" parent="1">

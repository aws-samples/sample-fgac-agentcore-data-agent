        <mxCell id="glue3" value="Glue Data Catalog&#xa;&#xa;tickit2 database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
